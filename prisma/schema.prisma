generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  VIEWER
}

enum ProcessType {
  CUTTING
  DYEING
  PRINTING
  EMBROIDERY
  STITCHING
  WASHING
  FINISHING
  OTHER
}

enum JobUnit {
  METERS
  PIECES
  KILOGRAMS
  YARDS
  SETS
}

enum RateType {
  PER_UNIT
  FIXED
}

enum ProductionOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_FOR_DISPATCH
  DELIVERED
  CLOSED
  CANCELLED
}

enum StageStatus {
  LOCKED
  READY
  IN_PROGRESS
  WAITING_APPROVAL
  COMPLETED
  SKIPPED
}

enum JobStatus {
  CREATED
  DISPATCHED
  IN_PROGRESS
  PARTIALLY_RETURNED
  RETURNED
  QUALITY_CHECK
  APPROVED
  COMPLETED
  CANCELLED
}

enum QualityGrade {
  A
  B
  C
  REJECTED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

enum PaymentTerms {
  IMMEDIATE
  DAYS_7
  DAYS_15
  DAYS_30
  DAYS_45
  DAYS_60
  CUSTOM
}

enum ActivityType {
  PO_CREATED
  PO_STATUS_CHANGED
  STAGE_STARTED
  STAGE_COMPLETED
  JOB_CREATED
  JOB_DISPATCHED
  JOB_STATUS_CHANGED
  RETURN_RECORDED
  QUALITY_APPROVED
  PAYMENT_RECORDED
  USER_LOGIN
  OTHER
}

enum AttachmentType {
  CHALLAN
  INVOICE
  QA_REPORT
  SHADE_CARD
  PO_DOCUMENT
  SPECIFICATION
  OTHER
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  gstNumber String?  @map("gst_number") @db.VarChar(15)
  currency  String   @default("INR") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  buyers            Buyer[]
  contractors       Contractor[]
  productionOrders  ProductionOrder[]
  jobs              Job[]
  jobReturns        JobReturn[]
  payments          Payment[]
  wastageThresholds WastageThreshold[]
  events            Event[]
  activityLogs      ActivityLog[]
  attachments       Attachment[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  email          String   @unique @db.VarChar(255)
  name           String   @db.VarChar(255)
  role           UserRole @default(OWNER)
  supabaseAuthId String   @unique @map("supabase_auth_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization?     @relation(fields: [organizationId], references: [id])
  productionOrders ProductionOrder[] @relation("POCreator")
  jobsCreated      Job[]             @relation("JobCreator")
  returnsRecorded  JobReturn[]       @relation("ReturnRecorder")
  paymentsRecorded Payment[]         @relation("PaymentRecorder")
  events           Event[]
  activityLogs     ActivityLog[]

  @@index([organizationId])
  @@index([supabaseAuthId])
  @@map("users")
}

model Buyer {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  name                  String        @db.VarChar(255)
  companyName           String        @map("company_name") @db.VarChar(255)
  contactPerson         String?       @map("contact_person") @db.VarChar(255)
  phone                 String?       @db.VarChar(20)
  email                 String?       @db.VarChar(255)
  gstNumber             String?       @map("gst_number") @db.VarChar(15)
  address               String?       @db.Text
  city                  String?       @db.VarChar(100)
  state                 String?       @db.VarChar(100)
  preferredPaymentTerms PaymentTerms? @map("preferred_payment_terms")
  creditLimit           Decimal?      @map("credit_limit") @db.Decimal(12, 2)
  notes                 String?       @db.Text
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  productionOrders ProductionOrder[]

  @@index([organizationId])
  @@map("buyers")
}

model Contractor {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  name                  String        @db.VarChar(255)
  phone                 String?       @db.VarChar(20)
  address               String?       @db.Text
  gstNumber             String?       @map("gst_number") @db.VarChar(15)
  contractorType        ProcessType   @map("contractor_type")
  specializations       ProcessType[]
  contactPerson         String?       @map("contact_person") @db.VarChar(255)
  email                 String?       @db.VarChar(255)
  rating                Decimal?      @db.Decimal(3, 2)
  notes                 String?       @db.Text
  preferredPaymentTerms PaymentTerms? @map("preferred_payment_terms")
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  jobs         Job[]
  payments     Payment[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("contractors")
}

model ProductionOrder {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  orderNumber    String  @unique @map("order_number") @db.VarChar(30)
  buyerId        String? @map("buyer_id") @db.Uuid

  // Buyer Snapshot
  buyerName          String? @map("buyer_name") @db.VarChar(255)
  buyerCompanyName   String? @map("buyer_company_name") @db.VarChar(255)
  buyerContactPerson String? @map("buyer_contact_person") @db.VarChar(255)
  buyerPhone         String? @map("buyer_phone") @db.VarChar(20)
  buyerEmail         String? @map("buyer_email") @db.VarChar(255)
  buyerGstNumber     String? @map("buyer_gst_number") @db.VarChar(15)
  buyerAddress       String? @map("buyer_address") @db.Text

  styleNumber   String?               @map("style_number") @db.VarChar(100)
  description   String                @db.Text
  materialType  String?               @map("material_type") @db.VarChar(255)
  color         String?               @db.VarChar(100)
  gsm           Decimal?              @db.Decimal(6, 1)
  totalQuantity Decimal               @map("total_quantity") @db.Decimal(12, 3)
  unit          JobUnit
  deadline      DateTime?             @db.Date
  status        ProductionOrderStatus @default(DRAFT)
  notes         String?               @db.Text
  createdById   String                @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  buyer        Buyer?       @relation(fields: [buyerId], references: [id])
  createdBy    User         @relation("POCreator", fields: [createdById], references: [id])

  stages       ProductionStage[]
  activityLogs ActivityLog[]
  attachments  Attachment[]

  @@index([organizationId, status])
  @@index([organizationId, buyerId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("production_orders")
}

model ProductionStage {
  id                String      @id @default(uuid()) @db.Uuid
  productionOrderId String      @map("production_order_id") @db.Uuid
  processType       ProcessType @map("process_type")
  sequenceNumber    Int         @map("sequence_number")
  status            StageStatus @default(LOCKED)

  startDate              DateTime? @map("start_date")
  expectedCompletionDate DateTime? @map("expected_completion_date")
  completedDate          DateTime? @map("completed_date")
  remarks                String?   @db.Text
  manualOverrideReason   String?   @map("manual_override_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  jobs            Job[]
  attachments     Attachment[]

  @@unique([productionOrderId, sequenceNumber])
  @@unique([productionOrderId, processType])
  @@index([productionOrderId])
  @@map("production_stages")
}

model Job {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  challanNumber  String  @unique @map("challan_number") @db.VarChar(20)
  stageId        String? @map("stage_id") @db.Uuid
  contractorId   String  @map("contractor_id") @db.Uuid

  // Contractor Snapshot
  contractorName      String? @map("contractor_name") @db.VarChar(255)
  contractorPhone     String? @map("contractor_phone") @db.VarChar(20)
  contractorAddress   String? @map("contractor_address") @db.Text
  contractorGstNumber String? @map("contractor_gst_number") @db.VarChar(15)

  processType         ProcessType @map("process_type")
  materialDescription String      @map("material_description") @db.Text
  lotNumber           String?     @map("lot_number") @db.VarChar(50)
  quantitySent        Decimal     @map("quantity_sent") @db.Decimal(12, 3)
  unit                JobUnit

  // Financials & Transport
  rate          Decimal?  @db.Decimal(10, 2)
  rateType      RateType? @map("rate_type")
  unitRate      Decimal?  @map("unit_rate") @db.Decimal(10, 2)
  amount        Decimal?  @db.Decimal(12, 2)
  transportCost Decimal?  @map("transport_cost") @db.Decimal(10, 2)
  vehicleNumber String?   @map("vehicle_number") @db.VarChar(50)
  driverName    String?   @map("driver_name") @db.VarChar(255)

  expectedReturnDate DateTime  @map("expected_return_date") @db.Date
  actualReturnDate   DateTime? @map("actual_return_date") @db.Date
  quantityReturned   Decimal   @default(0) @map("quantity_returned") @db.Decimal(12, 3)
  rejectionQuantity  Decimal   @default(0) @map("rejection_quantity") @db.Decimal(12, 3)
  wastageQuantity    Decimal   @default(0) @map("wastage_quantity") @db.Decimal(12, 3)
  wastagePercentage  Decimal   @default(0) @map("wastage_percentage") @db.Decimal(5, 2)
  status             JobStatus @default(CREATED)
  notes              String?   @db.Text
  createdById        String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  stage        ProductionStage? @relation(fields: [stageId], references: [id])
  contractor   Contractor       @relation(fields: [contractorId], references: [id])
  createdBy    User             @relation("JobCreator", fields: [createdById], references: [id])

  returns     JobReturn[]
  payments    Payment[]
  attachments Attachment[]

  @@index([organizationId, status])
  @@index([organizationId, contractorId])
  @@index([organizationId, expectedReturnDate])
  @@index([organizationId, processType])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([stageId])
  @@map("jobs")
}

model JobReturn {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  jobId             String       @map("job_id") @db.Uuid
  quantityReturned  Decimal      @map("quantity_returned") @db.Decimal(12, 3)
  returnDate        DateTime     @map("return_date") @db.Date
  qualityGrade      QualityGrade @default(A) @map("quality_grade")
  rejectionQuantity Decimal      @default(0) @map("rejection_quantity") @db.Decimal(12, 3)
  qualityNotes      String?      @map("quality_notes") @db.Text

  receivedBy   String?   @map("received_by") @db.VarChar(255)
  receivedDate DateTime? @map("received_date") @db.Date
  remarks      String?   @db.Text

  recordedById String   @map("recorded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  job          Job          @relation(fields: [jobId], references: [id])
  recordedBy   User         @relation("ReturnRecorder", fields: [recordedById], references: [id])

  @@index([jobId])
  @@map("job_returns")
}

model Payment {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  contractorId    String      @map("contractor_id") @db.Uuid
  jobId           String?     @map("job_id") @db.Uuid
  amount          Decimal     @db.Decimal(12, 2)
  paymentDate     DateTime    @map("payment_date") @db.Date
  paymentMode     PaymentMode @map("payment_mode")
  referenceNumber String?     @map("reference_number") @db.VarChar(100)
  notes           String?     @db.Text
  recordedById    String      @map("recorded_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  contractor   Contractor   @relation(fields: [contractorId], references: [id])
  job          Job?         @relation(fields: [jobId], references: [id])
  recordedBy   User         @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([organizationId, contractorId])
  @@index([organizationId, paymentDate(sort: Desc)])
  @@index([jobId])
  @@map("payments")
}

model WastageThreshold {
  id                   String      @id @default(uuid()) @db.Uuid
  organizationId       String      @map("organization_id") @db.Uuid
  processType          ProcessType @map("process_type")
  maxWastagePercentage Decimal     @map("max_wastage_percentage") @db.Decimal(5, 2)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, processType])
  @@map("wastage_thresholds")
}

model Event {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(50)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  data           Json     @db.JsonB
  metadata       Json?    @db.JsonB
  occurredAt     DateTime @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, eventType, occurredAt(sort: Desc)])
  @@map("events")
}

model ActivityLog {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  productionOrderId String? @map("production_order_id") @db.Uuid
  userId            String  @map("user_id") @db.Uuid

  actionType     ActivityType @map("action_type")
  description    String       @db.Text
  previousStatus String?      @map("previous_status") @db.VarChar(50)
  newStatus      String?      @map("new_status") @db.VarChar(50)

  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@index([organizationId, productionOrderId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model Attachment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  productionOrderId String? @map("production_order_id") @db.Uuid
  stageId           String? @map("stage_id") @db.Uuid
  jobId             String? @map("job_id") @db.Uuid

  fileUrl  String         @map("file_url") @db.Text
  fileType AttachmentType @map("file_type")
  fileName String         @map("file_name") @db.VarChar(255)
  fileSize Int?           @map("file_size")
  mimeType String?        @map("mime_type") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stage           ProductionStage? @relation(fields: [stageId], references: [id], onDelete: Cascade)
  job             Job?             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, productionOrderId])
  @@index([organizationId, stageId])
  @@index([organizationId, jobId])
  @@map("attachments")
}
