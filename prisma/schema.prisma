generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  VIEWER
}

enum ProcessType {
  CUTTING
  DYEING
  PRINTING
  EMBROIDERY
  STITCHING
  WASHING
  FINISHING
  OTHER
}

enum JobUnit {
  METERS
  PIECES
  KILOGRAMS
  YARDS
  SETS
}

enum RateType {
  PER_UNIT
  FIXED
}

enum JobStatus {
  SENT
  IN_PROGRESS
  PARTIALLY_RETURNED
  COMPLETED
  CLOSED
}

enum ProductionOrderStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StageStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
}

enum QualityGrade {
  A
  B
  C
  REJECTED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  gstNumber String?  @map("gst_number") @db.VarChar(15)
  currency  String   @default("INR") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  buyers             Buyer[]
  contractors        Contractor[]
  productionOrders   ProductionOrder[]
  jobs               Job[]
  payments           Payment[]
  wastageThresholds  WastageThreshold[]
  events             Event[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  email          String   @unique @db.VarChar(255)
  name           String   @db.VarChar(255)
  role           UserRole @default(OWNER)
  supabaseAuthId String   @unique @map("supabase_auth_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization?     @relation(fields: [organizationId], references: [id])
  productionOrders   ProductionOrder[] @relation("POCreator")
  jobsCreated        Job[]             @relation("JobCreator")
  returnsRecorded    JobReturn[]       @relation("ReturnRecorder")
  paymentsRecorded   Payment[]         @relation("PaymentRecorder")
  events             Event[]

  @@index([organizationId])
  @@index([supabaseAuthId])
  @@map("users")
}

model Buyer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(255)
  contactPerson  String?  @map("contact_person") @db.VarChar(255)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  productionOrders ProductionOrder[]

  @@index([organizationId])
  @@map("buyers")
}

model Contractor {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  name            String        @db.VarChar(255)
  phone           String?       @db.VarChar(20)
  address         String?       @db.Text
  gstNumber       String?       @map("gst_number") @db.VarChar(15)
  specializations ProcessType[]
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  jobs         Job[]
  payments     Payment[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("contractors")
}

model ProductionOrder {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  orderNumber     String                 @map("order_number") @db.VarChar(30)
  buyerId         String?                @map("buyer_id") @db.Uuid
  styleNumber     String?                @map("style_number") @db.VarChar(100)
  description     String                 @db.Text
  materialType    String?                @map("material_type") @db.VarChar(255)
  color           String?                @db.VarChar(100)
  gsm             Decimal?               @db.Decimal(6, 1)
  totalQuantity   Decimal                @map("total_quantity") @db.Decimal(12, 3)
  unit            JobUnit
  deadline        DateTime?              @db.Date
  status          ProductionOrderStatus  @default(CREATED)
  notes           String?                @db.Text
  createdById     String                 @map("created_by") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  buyer        Buyer?             @relation(fields: [buyerId], references: [id])
  createdBy    User               @relation("POCreator", fields: [createdById], references: [id])
  stages       ProductionStage[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([organizationId, buyerId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("production_orders")
}

model ProductionStage {
  id                String      @id @default(uuid()) @db.Uuid
  productionOrderId String      @map("production_order_id") @db.Uuid
  processType       ProcessType @map("process_type")
  sequenceNumber    Int         @map("sequence_number")
  status            StageStatus @default(PENDING)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  jobs            Job[]

  @@unique([productionOrderId, sequenceNumber])
  @@unique([productionOrderId, processType])
  @@index([productionOrderId])
  @@map("production_stages")
}

model Job {
  id                  String      @id @default(uuid()) @db.Uuid
  organizationId      String      @map("organization_id") @db.Uuid
  challanNumber       String      @map("challan_number") @db.VarChar(20)
  stageId             String?     @map("stage_id") @db.Uuid
  contractorId        String      @map("contractor_id") @db.Uuid
  processType         ProcessType @map("process_type")
  materialDescription String      @map("material_description") @db.Text
  lotNumber           String?     @map("lot_number") @db.VarChar(50)
  quantitySent        Decimal     @map("quantity_sent") @db.Decimal(12, 3)
  unit                JobUnit
  rate                Decimal?    @db.Decimal(10, 2)
  rateType            RateType?   @map("rate_type")
  expectedReturnDate  DateTime    @map("expected_return_date") @db.Date
  actualReturnDate    DateTime?   @map("actual_return_date") @db.Date
  quantityReturned    Decimal     @default(0) @map("quantity_returned") @db.Decimal(12, 3)
  rejectionQuantity   Decimal     @default(0) @map("rejection_quantity") @db.Decimal(12, 3)
  wastageQuantity     Decimal     @default(0) @map("wastage_quantity") @db.Decimal(12, 3)
  wastagePercentage   Decimal     @default(0) @map("wastage_percentage") @db.Decimal(5, 2)
  status              JobStatus   @default(SENT)
  notes               String?     @db.Text
  createdById         String      @map("created_by") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  stage        ProductionStage? @relation(fields: [stageId], references: [id])
  contractor   Contractor       @relation(fields: [contractorId], references: [id])
  createdBy    User             @relation("JobCreator", fields: [createdById], references: [id])
  returns      JobReturn[]
  payments     Payment[]

  @@unique([organizationId, challanNumber])
  @@index([organizationId, status])
  @@index([organizationId, contractorId])
  @@index([organizationId, expectedReturnDate])
  @@index([organizationId, processType])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([stageId])
  @@map("jobs")
}

model JobReturn {
  id                String       @id @default(uuid()) @db.Uuid
  jobId             String       @map("job_id") @db.Uuid
  quantityReturned  Decimal      @map("quantity_returned") @db.Decimal(12, 3)
  returnDate        DateTime     @map("return_date") @db.Date
  qualityGrade      QualityGrade @map("quality_grade") @default(A)
  rejectionQuantity Decimal      @default(0) @map("rejection_quantity") @db.Decimal(12, 3)
  qualityNotes      String?      @map("quality_notes") @db.Text
  recordedById      String       @map("recorded_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")

  job        Job  @relation(fields: [jobId], references: [id])
  recordedBy User @relation("ReturnRecorder", fields: [recordedById], references: [id])

  @@index([jobId])
  @@map("job_returns")
}

model Payment {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  contractorId    String      @map("contractor_id") @db.Uuid
  jobId           String?     @map("job_id") @db.Uuid
  amount          Decimal     @db.Decimal(12, 2)
  paymentDate     DateTime    @map("payment_date") @db.Date
  paymentMode     PaymentMode @map("payment_mode")
  referenceNumber String?     @map("reference_number") @db.VarChar(100)
  notes           String?     @db.Text
  recordedById    String      @map("recorded_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  contractor   Contractor   @relation(fields: [contractorId], references: [id])
  job          Job?         @relation(fields: [jobId], references: [id])
  recordedBy   User         @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([organizationId, contractorId])
  @@index([organizationId, paymentDate(sort: Desc)])
  @@index([jobId])
  @@map("payments")
}

model WastageThreshold {
  id                   String      @id @default(uuid()) @db.Uuid
  organizationId       String      @map("organization_id") @db.Uuid
  processType          ProcessType @map("process_type")
  maxWastagePercentage Decimal     @map("max_wastage_percentage") @db.Decimal(5, 2)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, processType])
  @@map("wastage_thresholds")
}

model Event {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventType      String   @map("event_type") @db.VarChar(50)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  data           Json     @db.JsonB
  metadata       Json?    @db.JsonB
  occurredAt     DateTime @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation(fields: [actorId], references: [id])

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, eventType, occurredAt(sort: Desc)])
  @@map("events")
}
